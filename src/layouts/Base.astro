---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /**
   * Path to the OG image, relative to /public. Defaults to /og.png.
   * Per-page OGs are generated by scripts/generate-assets.ts.
   */
  ogImage?: string
  /** Twitter card image. Defaults to /og-twitter.png. */
  twitterImage?: string
  /** Canonical URL for this page. Auto-derived from Astro.url when omitted. */
  canonical?: string
}

const siteUrl = 'https://v0-cli.crafter.run'
const siteName = 'v0-cli'
const twitterHandle = '@raillyhugo'

const {
  title = 'v0-cli. Agent-first CLI for the v0 Platform API.',
  description = 'A single v0 binary. 55 operations. Stable JSON output, trust ladder, audit trail, intent tokens for destructive ops.',
  ogImage = '/og.png',
  twitterImage = '/og-twitter.png',
  canonical,
} = Astro.props

const absoluteOg = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`
const absoluteTwitter = twitterImage.startsWith('http')
  ? twitterImage
  : `${siteUrl}${twitterImage}`

const canonicalUrl = canonical
  ? canonical
  : Astro.url
    ? new URL(Astro.url.pathname, siteUrl).toString()
    : siteUrl
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Theme bootstrap — runs before first paint to avoid FOUC. Reads the
        user's stored preference or falls back to prefers-color-scheme.
        Dark is the authoritative default when nothing is known. */}
    <script is:inline>
      ;(function () {
        try {
          var key = 'v0cli-theme'
          var stored = localStorage.getItem(key)
          var prefersLight =
            window.matchMedia &&
            window.matchMedia('(prefers-color-scheme: light)').matches
          var theme = stored === 'light' || stored === 'dark'
            ? stored
            : prefersLight
              ? 'light'
              : 'dark'
          document.documentElement.setAttribute('data-theme', theme)
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark')
        }
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={twitterHandle} />
    <meta name="twitter:creator" content={twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteTwitter} />
    <meta name="twitter:image:alt" content={title} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        var key = 'v0cli-theme'

        function labelFor(theme) {
          return theme === 'dark'
            ? 'Switch to light mode'
            : 'Switch to dark mode'
        }

        function syncButtons(theme) {
          var buttons = document.querySelectorAll('[data-theme-toggle]')
          for (var i = 0; i < buttons.length; i++) {
            buttons[i].setAttribute('aria-label', labelFor(theme))
            buttons[i].setAttribute(
              'aria-pressed',
              theme === 'light' ? 'true' : 'false',
            )
          }
        }

        function applyTheme(theme) {
          var prev = root.getAttribute('data-theme')
          if (prev === theme) return
          var useVT = typeof document.startViewTransition === 'function'
          if (useVT) {
            document.startViewTransition(function () {
              root.setAttribute('data-theme', theme)
            })
          } else {
            root.classList.add('theme-transitioning')
            root.setAttribute('data-theme', theme)
            window.setTimeout(function () {
              root.classList.remove('theme-transitioning')
            }, 220)
          }
          try {
            localStorage.setItem(key, theme)
          } catch (e) {}
          syncButtons(theme)
        }

        // Initial sync — the <head> bootstrap already set data-theme.
        syncButtons(root.getAttribute('data-theme') || 'dark')

        // Event delegation — one listener per page, works for any future
        // toggle (e.g. inside a mobile drawer).
        document.addEventListener('click', function (e) {
          var target = e.target
          if (!target || !target.closest) return
          var btn = target.closest('[data-theme-toggle]')
          if (!btn) return
          e.preventDefault()
          var current = root.getAttribute('data-theme') || 'dark'
          applyTheme(current === 'dark' ? 'light' : 'dark')
        })
      })()
    </script>
  </body>
</html>
