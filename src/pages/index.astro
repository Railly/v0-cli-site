---
import { Code } from 'astro:components'
import V0Logo from '../components/V0Logo.astro'
import Base from '../layouts/Base.astro'

const heroHuman = `# Shorthand for chat create.
v0 "landing page with hero + pricing"

# Iterate.
v0 msg send <chat> "swap the hero copy"

# Ship.
v0 deploy <chat> <version>`

const heroAgent = `# Preflight. Agents run this first.
v0 doctor --json

# Capture ids for later steps.
CHAT=$(v0 chat init --source . --json | jq -r '.data.id')
VER=$(v0 version list "$CHAT" --limit 1 --json \\
  | jq -r '.data.data[0].id')

# Deploy and wait for terminal status.
v0 deploy create "$CHAT" "$VER" --yes --wait --json`

const heroJson = `{
  "data": {
    "id": "chat_8kwbm",
    "object": "chat",
    "latestVersion": {
      "id": "ver_14lmv",
      "files": [{ "name": "app/page.tsx" }]
    }
  }
}`
---

<Base>
  <!-- Top nav -->
  <header class="relative z-10 flex items-center justify-between px-8 py-5 md:px-10">
    <a href="/" class="flex items-center gap-[3px] text-white" aria-label="v0-cli home">
      <V0Logo size={18} class="text-white" />
      <span class="font-sans text-base font-semibold tracking-tight">-cli</span>
    </a>
    <a
      href="https://github.com/Railly/v0-cli"
      target="_blank"
      rel="noreferrer"
      class="pill font-sans text-sm"
    >
      Star on GitHub
    </a>
  </header>

  <!-- Sub-nav -->
  <nav class="flex items-center justify-center gap-6 border-b border-[var(--color-hairline)] pb-4 text-sm text-[var(--color-text-secondary)]">
    <a href="#overview" class="transition-colors hover:text-white">Overview</a>
    <a href="#install" class="transition-colors hover:text-white">Install</a>
    <a href="#workflow" class="transition-colors hover:text-white">Workflow</a>
    <a href="#trust" class="transition-colors hover:text-white">Trust</a>
    <a href="https://github.com/Railly/v0-cli#readme" target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Docs ↗</a>
  </nav>

  <!-- HERO: two-column grid, left = pitch, right = code tabs -->
  <section id="overview" class="relative mx-auto w-full max-w-[1320px] px-6 pt-20 pb-24 md:px-10 md:pt-24">
    <!-- single hairline crosshair top-left as subtle tech mark -->
    <span class="crosshair absolute" style="top:56px;left:16px"></span>

    <div class="grid items-start gap-12 lg:grid-cols-[minmax(0,440px)_1fr] lg:gap-16">
      <!-- Left: headline + subtitle + CTAs -->
      <div>
        <h1
          class="font-sans font-semibold text-white"
          style="font-size:clamp(44px,5vw,64px);line-height:1.02;letter-spacing:-0.03em;"
        >
          <span class="inline-flex items-baseline gap-3">
            The
            <V0Logo size={52} class="text-white" />
            CLI
          </span>
          <br />For Developers
        </h1>
        <p class="mt-6 max-w-[420px] text-[var(--color-text-secondary)]" style="font-size:18px;line-height:1.5;">
          Create, iterate, and deploy v0 chats from the terminal. Stable JSON,
          trust ladder, audit trail, single-use intent tokens for destructive ops.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#install"
            class="pill"
            style="background:#ededed;color:#000;border-color:#ededed;padding:11px 18px;font-weight:500;"
          >
            <V0Logo size={14} class="text-black" />
            Get started
          </a>
          <a
            href="https://github.com/Railly/v0-cli"
            target="_blank"
            rel="noreferrer"
            class="pill"
            style="padding:11px 18px;font-weight:500;"
          >
            View on GitHub ↗
          </a>
        </div>
        <div class="mt-6 flex items-center gap-3 text-sm text-[var(--color-text-secondary)]">
          <span>Pairs with</span>
          <span class="pill pill-sm">Claude Code</span>
          <span class="pill pill-sm">Cursor</span>
          <a href="#install" class="underline decoration-[var(--color-hairline)] underline-offset-4 hover:text-white">and agents</a>
        </div>
      </div>

      <!-- Right: code block with tabs -->
      <div class="code-card" style="border-radius:var(--radius-card);">
        <div class="code-tabs">
          <button class="code-tab is-active" data-tab="human" type="button">human</button>
          <button class="code-tab" data-tab="agent" type="button">agent</button>
          <button class="code-tab" data-tab="json" type="button">--json</button>
          <span class="ml-auto pr-3 font-mono text-xs text-[var(--color-text-muted)]">bash</span>
        </div>
        <div class="code-panels">
          <div class="code-panel is-active" data-panel="human">
            <Code code={heroHuman} lang="bash" theme="vesper" />
          </div>
          <div class="code-panel" data-panel="agent">
            <Code code={heroAgent} lang="bash" theme="vesper" />
          </div>
          <div class="code-panel" data-panel="json">
            <Code code={heroJson} lang="json" theme="vesper" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature grid: 3-up, AI-Gateway-style one-liner cards -->
  <section class="mx-auto w-full max-w-[1320px] border-t border-[var(--color-hairline)] px-6 md:px-10">
    <div class="grid divide-[var(--color-hairline)] md:grid-cols-3 md:divide-x">
      <div class="px-2 py-12 md:px-10">
        <h3 class="font-sans font-semibold text-white" style="font-size:22px;line-height:1.2;letter-spacing:-0.01em;">
          One API key,<br />hundreds of commands
        </h3>
        <p class="mt-4 text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
          Single <code class="font-mono text-[13px] text-white">v0</code> binary maps the entire v0 Platform API.
          55 operations across chats, versions, deployments, env vars, webhooks, MCP servers.
        </p>
      </div>
      <div class="px-2 py-12 md:px-10">
        <h3 class="font-sans font-semibold text-white" style="font-size:22px;line-height:1.2;letter-spacing:-0.01em;">
          Stable JSON,<br />human-readable default
        </h3>
        <p class="mt-4 text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
          TTY gets a formatted output. Pipe or add <code class="font-mono text-[13px] text-white">--json</code> and
          the same command returns a stable envelope ready for <code class="font-mono text-[13px] text-white">jq</code>.
        </p>
      </div>
      <div class="px-2 py-12 md:px-10">
        <h3 class="font-sans font-semibold text-white" style="font-size:22px;line-height:1.2;letter-spacing:-0.01em;">
          Safe by default,<br />destructive by intent
        </h3>
        <p class="mt-4 text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
          Reads are silent. Writes log. Destructive operations require a single-use intent token bound to the exact
          action and params it was minted for.
        </p>
      </div>
    </div>
  </section>

  <!-- Install -->
  <section id="install" class="mx-auto w-full max-w-[1320px] border-t border-[var(--color-hairline)] px-6 py-24 md:px-10">
    <div class="grid gap-12 lg:grid-cols-[260px_1fr]">
      <div>
        <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
          <V0Logo size={12} class="text-[var(--color-text-muted)]" />
          <span>Install</span>
        </div>
        <h2 class="font-sans font-semibold text-white" style="font-size:34px;line-height:1.1;letter-spacing:-0.02em;">
          Binary or skill.<br />One line either way.
        </h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <div class="code-card p-6">
          <div class="mb-3 flex items-center justify-between text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
            <span>CLI binary</span>
            <span class="font-mono normal-case tracking-normal text-[var(--color-text-muted)]">bash</span>
          </div>
          <Code code={`bun install -g @crafter/v0-cli\nv0 doctor`} lang="bash" theme="vesper" />
          <p class="mt-5 text-sm text-[var(--color-text-secondary)]">
            Needs <code class="font-mono text-[13px] text-white">V0_API_KEY</code>. Self-contained, no post-install step.
          </p>
        </div>
        <div class="code-card p-6">
          <div class="mb-3 flex items-center justify-between text-[11px] uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
            <span>Agent skill</span>
            <span class="font-mono normal-case tracking-normal text-[var(--color-text-muted)]">bash</span>
          </div>
          <Code code={`npx skills add Railly/v0-cli`} lang="bash" theme="vesper" />
          <p class="mt-5 text-sm text-[var(--color-text-secondary)]">
            Teaches Claude Code, Cursor, or any agent the preflight recipe, the JSON contract,
            the trust ladder, and how intent tokens work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Workflow split card: left text, right panels -->
  <section id="workflow" class="mx-auto w-full max-w-[1320px] border-t border-[var(--color-hairline)] px-6 py-24 md:px-10">
    <div class="grid gap-12 lg:grid-cols-[260px_1fr]">
      <div>
        <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
          <V0Logo size={12} class="text-[var(--color-text-muted)]" />
          <span>Workflow</span>
        </div>
        <h2 class="font-sans font-semibold text-white" style="font-size:34px;line-height:1.1;letter-spacing:-0.02em;">
          Human first.<br /><span class="text-[var(--color-text-secondary)]">JSON for agents.</span>
        </h2>
        <p class="mt-4 text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
          Default output is readable. Add <code class="font-mono text-[13px] text-white">--json</code> and the
          exact same command returns a stable envelope that pipes cleanly into
          <code class="font-mono text-[13px] text-white">jq</code>.
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <div class="code-card p-0 overflow-hidden">
          <div class="code-tabs" style="border-bottom:1px solid var(--color-hairline);">
            <span class="code-tab is-static">human</span>
            <span class="ml-auto pr-3 font-mono text-xs text-[var(--color-text-muted)]">bash</span>
          </div>
          <div class="p-6">
            <Code code={heroHuman} lang="bash" theme="vesper" />
          </div>
        </div>
        <div class="code-card p-0 overflow-hidden">
          <div class="code-tabs" style="border-bottom:1px solid var(--color-hairline);">
            <span class="code-tab is-static">agent</span>
            <span class="ml-auto pr-3 font-mono text-xs text-[var(--color-text-muted)]">bash</span>
          </div>
          <div class="p-6">
            <Code code={heroAgent} lang="bash" theme="vesper" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust ladder: 4 hairline cards, horizontal -->
  <section id="trust" class="mx-auto w-full max-w-[1320px] border-t border-[var(--color-hairline)] px-6 py-24 md:px-10">
    <div class="grid gap-12 lg:grid-cols-[260px_1fr]">
      <div>
        <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
          <V0Logo size={12} class="text-[var(--color-text-muted)]" />
          <span>Trust ladder</span>
        </div>
        <h2 class="font-sans font-semibold text-white" style="font-size:34px;line-height:1.1;letter-spacing:-0.02em;">
          Four levels.<br /><span class="text-[var(--color-text-secondary)]">Readable from the command name.</span>
        </h2>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        <article class="code-card p-6">
          <div class="mb-2 flex items-baseline gap-3">
            <span class="font-mono text-sm text-[var(--color-text-muted)]">T0</span>
            <h3 class="font-sans font-semibold text-white" style="font-size:20px;letter-spacing:-0.01em;">Auto.</h3>
          </div>
          <p class="text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
            Silent reads. <code class="font-mono text-[13px] text-white">v0 doctor</code>,
            <code class="font-mono text-[13px] text-white">auth whoami</code>,
            <code class="font-mono text-[13px] text-white">project list</code>, every
            <code class="font-mono text-[13px] text-white">list</code> and
            <code class="font-mono text-[13px] text-white">show</code>.
          </p>
        </article>
        <article class="code-card p-6">
          <div class="mb-2 flex items-baseline gap-3">
            <span class="font-mono text-sm text-[var(--color-text-muted)]">T1</span>
            <h3 class="font-sans font-semibold text-white" style="font-size:20px;letter-spacing:-0.01em;">Log.</h3>
          </div>
          <p class="text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
            Audit only, no prompt. <code class="font-mono text-[13px] text-white">chat create</code>,
            <code class="font-mono text-[13px] text-white">chat init</code>,
            <code class="font-mono text-[13px] text-white">msg send</code>,
            <code class="font-mono text-[13px] text-white">env set</code> (plain keys),
            <code class="font-mono text-[13px] text-white">project create</code>.
          </p>
        </article>
        <article class="code-card p-6">
          <div class="mb-2 flex items-baseline gap-3">
            <span class="font-mono text-sm text-[var(--color-text-muted)]">T2</span>
            <h3 class="font-sans font-semibold text-white" style="font-size:20px;letter-spacing:-0.01em;">Confirm.</h3>
          </div>
          <p class="text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
            TTY prompt or <code class="font-mono text-[13px] text-white">--yes</code>. Exits 2 in JSON
            mode without it. Covers <code class="font-mono text-[13px] text-white">deploy create</code>,
            <code class="font-mono text-[13px] text-white">env list --decrypted</code>,
            <code class="font-mono text-[13px] text-white">chat delete</code>.
          </p>
        </article>
        <article class="code-card p-6">
          <div class="mb-2 flex items-baseline gap-3">
            <span class="font-mono text-sm text-[var(--color-text-muted)]">T3</span>
            <h3 class="font-sans font-semibold text-white" style="font-size:20px;letter-spacing:-0.01em;">Killswitch.</h3>
          </div>
          <p class="text-[var(--color-text-secondary)]" style="font-size:15px;line-height:1.55;">
            Single-use intent token bound to <code class="font-mono text-[13px] text-white">action + hash(params)</code>.
            Expires. Cannot be reused. Cannot be retargeted.
            <code class="font-mono text-[13px] text-white">hook delete</code>,
            <code class="font-mono text-[13px] text-white">deploy delete</code>,
            <code class="font-mono text-[13px] text-white">env delete</code> (bulk).
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ accordion -->
  <section class="mx-auto w-full max-w-[1320px] border-t border-[var(--color-hairline)] px-6 py-24 md:px-10">
    <div class="grid gap-12 lg:grid-cols-[260px_1fr]">
      <div>
        <div class="mb-3 flex items-center gap-2 text-xs uppercase tracking-[0.14em] text-[var(--color-text-muted)]">
          <V0Logo size={12} class="text-[var(--color-text-muted)]" />
          <span>FAQ</span>
        </div>
        <h2 class="font-sans font-semibold text-white" style="font-size:34px;line-height:1.1;letter-spacing:-0.02em;">
          Frequently<br />Asked Questions
        </h2>
      </div>
      <div class="divide-y divide-[var(--color-hairline)] border-y border-[var(--color-hairline)]">
        <details class="faq group">
          <summary class="faq-summary">What is v0-cli?</summary>
          <div class="faq-body">
            A single <code class="font-mono text-[13px] text-white">v0</code> binary that wraps the v0 Platform API.
            It mirrors the entire SDK surface, enforces a trust ladder, emits stable JSON for agents, and keeps
            an audit trail for every run.
          </div>
        </details>
        <details class="faq group">
          <summary class="faq-summary">How is the trust ladder enforced?</summary>
          <div class="faq-body">
            The CLI classifies every command into T0 (silent read) through T3 (destructive, intent-token
            required). Killswitch on disk blocks T2 and T3 instantly. Intent tokens are bound to
            <code class="font-mono text-[13px] text-white">action + hash(params)</code>, single-use, with a default
            15-minute TTL.
          </div>
        </details>
        <details class="faq group">
          <summary class="faq-summary">What about rate limits and retries?</summary>
          <div class="faq-body">
            Writes consult <code class="font-mono text-[13px] text-white">/rate-limits</code> before dispatching and
            exit 3 when under threshold. On HTTP 429 or 5xx the CLI retries with exponential backoff plus jitter,
            up to four attempts.
          </div>
        </details>
        <details class="faq group">
          <summary class="faq-summary">Can agents run it safely?</summary>
          <div class="faq-body">
            That's the point. <code class="font-mono text-[13px] text-white">--json</code> is the canonical contract,
            exit codes are stable (0 ok, 1 API, 2 validation, 3 rate-limited, 4 killswitch, 5 intent required/invalid,
            6 network). Every run writes a two-phase entry (pending then ok or error) to
            <code class="font-mono text-[13px] text-white">~/.v0cli/audit/</code>.
          </div>
        </details>
        <details class="faq group">
          <summary class="faq-summary">Where do I get an API key?</summary>
          <div class="faq-body">
            From <a href="https://v0.app/chat/settings/keys" target="_blank" rel="noreferrer" class="text-white underline decoration-[var(--color-hairline)] underline-offset-4 hover:decoration-white">v0.app/chat/settings/keys</a>.
            Set it as <code class="font-mono text-[13px] text-white">V0_API_KEY</code> in your shell or save it to a profile with
            <code class="font-mono text-[13px] text-white">v0 auth login</code>.
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="mx-auto w-full max-w-[1320px] border-t border-[var(--color-hairline)] px-6 py-10 md:px-10">
    <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-[var(--color-text-muted)]">
      <div class="flex items-center gap-[3px] text-white">
        <V0Logo size={14} class="text-white" />
        <span class="font-mono">-cli</span>
        <span class="ml-2 text-[var(--color-text-muted)]">· MIT</span>
      </div>
      <nav class="flex items-center gap-6">
        <a href="https://github.com/Railly/v0-cli" target="_blank" rel="noreferrer" class="transition-colors hover:text-white">GitHub</a>
        <a href="https://v0.app/docs/api/platform" target="_blank" rel="noreferrer" class="transition-colors hover:text-white">Platform API</a>
        <a href="https://github.com/vercel/v0-sdk" target="_blank" rel="noreferrer" class="transition-colors hover:text-white">v0-sdk</a>
      </nav>
    </div>
  </footer>
</Base>

<script is:inline>
  // Hero code tabs: simple click swap. Only applies to the hero (first .code-tabs block).
  document.querySelectorAll('#overview .code-tabs').forEach((tabBar) => {
    const tabs = tabBar.querySelectorAll('.code-tab[data-tab]')
    const panels = tabBar.parentElement.querySelectorAll('.code-panel[data-panel]')
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab')
        tabs.forEach((t) => t.classList.toggle('is-active', t === tab))
        panels.forEach((p) =>
          p.classList.toggle('is-active', p.getAttribute('data-panel') === target),
        )
      })
    })
  })
</script>
