---
import V0Logo from './V0Logo.astro'

interface Props {
  active?: 'home' | 'docs'
}
const { active = 'home' } = Astro.props

const homeLinks = [
  { href: '/#overview', label: 'Overview' },
  { href: '/#install', label: 'Install' },
  { href: '/#workflow', label: 'Workflow' },
  { href: '/#parallel', label: 'Parallel' },
]

const docsLinks = [
  { href: '/docs/getting-started', label: 'Getting started' },
  { href: '/docs/commands', label: 'Commands' },
  { href: '/docs/agent-mode', label: 'Agent mode' },
  { href: '/docs/safety', label: 'Safety' },
  { href: '/docs/reference', label: 'Reference' },
]

const links = active === 'docs' ? docsLinks : homeLinks
---

<header class="relative z-20 flex items-center justify-between gap-6 border-b border-[var(--color-hairline)] px-6 py-4 md:px-10">
  <a href="/" class="flex items-center gap-[3px] text-white" aria-label="v0-cli home">
    <V0Logo size={18} class="text-white" />
    <span class="font-sans text-base font-semibold tracking-tight">-cli</span>
  </a>
  <nav class="hidden items-center gap-6 text-sm text-[var(--color-text-secondary)] md:flex">
    {
      links.map((l) => (
        <a href={l.href} class="transition-colors hover:text-white">
          {l.label}
        </a>
      ))
    }
    <a
      href={active === 'docs' ? '/' : '/docs'}
      class={`transition-colors hover:text-white ${active === 'docs' ? 'text-white' : ''}`}
    >
      {active === 'docs' ? 'Home' : 'Docs'}
    </a>
  </nav>
  <div class="flex items-center gap-3">
    <button
      type="button"
      data-theme-toggle
      class="pill pill-icon"
      aria-label="Switch to light mode"
      aria-pressed="false"
    >
      {/* Visible in dark mode — click to go light. */}
      <svg
        class="theme-icon-sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      {/* Visible in light mode — click to go dark. */}
      <svg
        class="theme-icon-moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
      </svg>
    </button>
    <a
      href="https://github.com/Railly/v0-cli"
      target="_blank"
      rel="noreferrer"
      class="pill font-sans text-sm"
    >
      Star on GitHub
    </a>
  </div>
</header>
